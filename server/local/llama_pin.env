# The one llama.cpp build Whisper Studio runs. macapp/build_app.sh bundles it
# into the Mac app and setup.sh installs it into vendor/llama for a source
# checkout, so both installs serve models with the same binary. The asset is
# the official macOS arm64 release tarball; the checksum is its sha256.
# server/local/llama_server.py::MIN_BUILD is this build number.
LLAMA_TAG=b11851
LLAMA_SHA256=eb0a16c62e4d7529610dbd17c913615ba26ed86b32e9c638be1e3b4fccb18771
