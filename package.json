{
  "name": "whisper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An AI-powered workspace that combines real-time speech transcription, conversational AI, and a full development environment in one browser tab.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "vendor:viz": "bash scripts/vendor-viz.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.105.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "exceljs": "4.4.0",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
